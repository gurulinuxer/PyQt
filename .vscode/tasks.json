{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create UI virtual environment",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "venv",
        "venv"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Install UI dependencies from requirements.txt",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; pip install -r requirements.txt }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Create UI virtual environment"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Compile UI file",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; pyside6-uic form.ui -o ui_form.py }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Install UI dependencies from requirements.txt"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run HelloWorld.py",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; python helloworld.py }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Compile UI file"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run all UI steps",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Create UI virtual environment",
        "Install UI dependencies from requirements.txt",
        "Compile UI file",
        "Run HelloWorld.py"
      ],
      "problemMatcher": []
    },

    /* QML project: separate venv + requirements */

    {
      "label": "Create QML virtual environment",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "venv",
        "venv"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Install QML dependencies from requirements.txt",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; pip install --upgrade -r requirements.txt }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "dependsOn": [
        "Create QML virtual environment"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run QML main.py",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; python main.py }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "dependsOn": [
        "Create QML virtual environment",
        "Install QML dependencies from requirements.txt"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
