{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create UI virtual environment",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "venv",
        "venv"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Install UI dependencies (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; pip install -r requirements.txt }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Create UI virtual environment"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Compile UI file (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; pyside6-uic form.ui -o ui_form.py }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Install UI dependencies (Windows)"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run HelloWorld.py (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; python helloworld.py }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Compile UI file (Windows)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Install UI dependencies (WSL/Linux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source venv/bin/activate && pip install -r requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Create UI virtual environment"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Compile UI file (WSL/Linux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source venv/bin/activate && pyside6-uic form.ui -o ui_form.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Install UI dependencies (WSL/Linux)"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run HelloWorld.py (WSL/Linux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source venv/bin/activate && python helloworld.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/uiproject"
      },
      "dependsOn": [
        "Compile UI file (WSL/Linux)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run all UI steps (WSL/Linux)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Create UI virtual environment",
        "Install UI dependencies (WSL/Linux)",
        "Compile UI file (WSL/Linux)",
        "Run HelloWorld.py (WSL/Linux)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run all UI steps (Windows)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Create UI virtual environment",
        "Install UI dependencies (Windows)",
        "Compile UI file (Windows)",
        "Run HelloWorld.py (Windows)"
      ],
      "problemMatcher": []
    },

    /* QML project: separate venv + requirements */

    {
      "label": "Create QML virtual environment",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "venv",
        "venv"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Install QML dependencies (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; pip install --upgrade -r requirements.txt }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "dependsOn": [
        "Create QML virtual environment"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run QML main.py (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { .\\venv\\Scripts\\Activate.ps1; python main.py }"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "dependsOn": [
        "Create QML virtual environment",
        "Install QML dependencies (Windows)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
    ,
    {
      "label": "Install QML dependencies (WSL/Linux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "./venv/bin/python -m pip install --upgrade -r requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "dependsOn": [
        "Create QML virtual environment"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run QML main.py (WSL/Linux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "./venv/bin/python main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qmlproject"
      },
      "dependsOn": [
        "Create QML virtual environment",
        "Install QML dependencies (WSL/Linux)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
